PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/finance_tracker
CLIENT_URL=http://localhost:3000

# Simple protection for the API. The frontend sends this in the x-api-key header.
# Leave empty to disable (only for local development).
API_KEY=change-me

# Reminder job: runs every day at this hour (0-23), server time
REMINDER_HOUR=9
# How many days before the due day the "upcoming" reminder is created
REMINDER_DAYS_BEFORE=3
TIMEZONE=Asia/Kolkata

# Optional: email reminders to yourself (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REMINDER_EMAIL_TO=
