PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/finance_tracker
CLIENT_URL=http://localhost:3000

# Login: the one static email and password for this app
# Secret used to sign login sessions. Keep it private; changing it logs everyone out.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# ADMIN_PASSWORD can be plain text (laptop only) or a bcrypt hash: npm run hash-password -- "your password"
# Changing either one logs out every device. Restart the backend after editing.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Reminder job: runs every day at this hour (0-23), server time
REMINDER_HOUR=9
# How many days before the due day the "upcoming" reminder is created
REMINDER_DAYS_BEFORE=3
TIMEZONE=Asia/Kolkata

# Optional: email reminders to yourself (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REMINDER_EMAIL_TO=

# Push notifications to the iPhone app. Create the keys with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret for GET /api/cron/run-reminders (for cron-job.org when the host sleeps). Leave empty to disable.
CRON_SECRET=
